<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- Layout for project-overview-view.fxml. -->

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.topscout.controller.ProjectOverviewController">
   <children>
      <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #C6AE93;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER" prefHeight="78.0" style="-fx-background-color: #0C256D;">
               <children>
                  <Button fx:id="home" mnemonicParsing="false" onAction="#homeButtonPressed" style="-fx-background-color: rgba(0,0,0,0);">
                     <graphic>
                        <ImageView fitHeight="32.0" fitWidth="27.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/home_button.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Label fx:id="nameOfProject" alignment="CENTER" maxWidth="Infinity" prefHeight="35.0" text="Project Name" textFill="WHITE" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <ImageView fitHeight="37.0" fitWidth="41.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/boy_scout_logo.png" />
                     </image>
                  </ImageView>
               </children>
               <padding>
                  <Insets left="20.0" right="20.0" />
               </padding>
            </HBox>
            <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #ffffff; -fx-border-color: #0C256D;" VBox.vgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Proposal Tasks" textFill="#0c256d">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <ProgressBar fx:id="proposalProgress" maxWidth="Infinity" prefHeight="31.0" progress="0.0" />
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-border-color: #FFFFFF; -fx-background-color: #FFFFFF; -fx-background: #FFFFFF;" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox spacing="10.0" style="-fx-background-color: #FFFFFF;">
                           <children>
                              <Button fx:id="contactInfo1" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToContactInfo" prefHeight="38.0" style="-fx-background-color: #F2F2F2; -fx-alignment: center-left;" text="Contact Information" textFill="#0c256d">
                                 <graphic>
                                    <ProgressIndicator prefHeight="21.0" prefWidth="28.0" progress="0.0">
                                       <padding>
                                          <Insets bottom="-10.0" />
                                       </padding>
                                    </ProgressIndicator>
                                 </graphic>
                              </Button>
                              <Button fx:id="projDescBenefits" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToProjDescBenefits" prefHeight="38.0" style="-fx-background-color: #F2F2F2; -fx-alignment: center-left;" text="Project Description and Benefit" textFill="#0c256d">
                                 <graphic>
                                    <ProgressIndicator prefHeight="21.0" prefWidth="28.0" progress="0.0">
                                       <padding>
                                          <Insets bottom="-10.0" />
                                       </padding>
                                    </ProgressIndicator>
                                 </graphic>
                              </Button>
                              <Button fx:id="suppliesCosts" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToSuppliesCost" prefHeight="38.0" style="-fx-background-color: #F2F2F2; -fx-alignment: center-left;" text="Supplies &amp; Cost" textFill="#0c256d">
                                 <graphic>
                                    <ProgressIndicator prefHeight="21.0" prefWidth="28.0" progress="0.0">
                                       <padding>
                                          <Insets bottom="-10.0" />
                                       </padding>
                                    </ProgressIndicator>
                                 </graphic>
                              </Button>
                              <Button fx:id="logisticsSafety" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToLogisticsSafety" prefHeight="38.0" style="-fx-background-color: #F2F2F2; -fx-alignment: center-left;" text="Logistics &amp; Safety" textFill="#0c256d">
                                 <graphic>
                                    <ProgressIndicator prefHeight="21.0" prefWidth="28.0" progress="0.0">
                                       <padding>
                                          <Insets bottom="-10.0" />
                                       </padding>
                                    </ProgressIndicator>
                                 </graphic>
                              </Button>
                              <Button fx:id="projectNotes" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToProjNotes" prefHeight="38.0" style="-fx-background-color: #F2F2F2; -fx-alignment: center-left;" text="Project Notes" textFill="#0c256d">
                                 <padding>
                                    <Insets left="40.0" />
                                 </padding>
                              </Button>
                           </children>
                           <padding>
                              <Insets right="8.0" />
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
                  <HBox alignment="CENTER_LEFT" prefHeight="31.0">
                     <children>
                        <Label maxWidth="Infinity" text="Pressing the back button saves progress." textFill="#0c256d" HBox.hgrow="ALWAYS">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <Button fx:id="delteProjectButton" mnemonicParsing="false" onAction="#deleteProject" prefHeight="25.0" prefWidth="188.0" style="-fx-background-color: #F00822;" text="Delete Project" textFill="WHITE" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="14.0" left="20.0" right="20.0" top="10.0" />
               </padding>
               <VBox.margin>
                  <Insets left="20.0" right="20.0" />
               </VBox.margin>
            </VBox>
            <HBox alignment="CENTER_LEFT" prefHeight="44.0" style="-fx-background-color: #0C256D;">
               <children>
                  <Button fx:id="leftArrow" mnemonicParsing="false" onAction="#backButtonPressed" style="-fx-background-color: rgba(0,0,0,0);">
                     <graphic>
                        <ImageView fitHeight="32.0" fitWidth="27.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/white_arrow_button.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>