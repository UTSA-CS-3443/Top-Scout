<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- Layout for main-view.fxml. -->

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.topscout.controller.MainScreenController">
   <children>
      <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #C6AE93;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER" prefHeight="78.0" style="-fx-background-color: #0C256D;">
               <children>
                  <ImageView fitHeight="51.0" fitWidth="61.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/boy_scout_logo.png" />
                     </image>
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </ImageView>
                  <Label style="-fx-font-family: &quot;Georgia&quot;, Times, serif;" text="Top Scout" textFill="WHITE">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <VBox spacing="10.0" style="-fx-background-color: #ffffff; -fx-border-color: #0C256D;" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER" prefHeight="44.0" spacing="10.0">
                     <children>
                        <Button fx:id="newProject" maxWidth="Infinity" mnemonicParsing="false" onAction="#makeProject" prefHeight="25.0" style="-fx-background-color: #F00822;" text="New Project" textFill="WHITE" HBox.hgrow="ALWAYS" />
                        <Button fx:id="tutorialButton" mnemonicParsing="false" onAction="#goToTutorial" prefHeight="25.0" prefWidth="220.0" style="-fx-background-color: #0C256D;" text="Getting Started" textFill="WHITE" />
                     </children>
                  </HBox>
                  <ListView fx:id="projectsList" maxWidth="Infinity" style="-fx-border-color: #ffffff;" VBox.vgrow="ALWAYS" />
               </children>
               <padding>
                  <Insets bottom="14.0" left="14.0" right="14.0" top="10.0" />
               </padding>
               <VBox.margin>
                  <Insets left="20.0" right="20.0" />
               </VBox.margin>
            </VBox>
            <HBox prefHeight="44.0" style="-fx-background-color: #0C256D;" />
         </children>
      </VBox>
   </children>
</AnchorPane>